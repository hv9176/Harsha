#include <iostream>
class BankAccount {
private:
    static double bankFunds;
public:
    void deposit(double amount) { if (amount > 0) bankFunds += amount; }
    void withdraw(double amount) { if (amount > 0 && amount <= bankFunds) bankFunds -= amount; }
    static double getBankFunds() { return bankFunds; }
};
double BankAccount::bankFunds = 0.0;
int main() {
    BankAccount acc1, acc2;
    acc1.deposit(500);
    acc2.deposit(1000);
    acc1.withdraw(300);
    std::cout << "Total Bank Funds: " << BankAccount::getBankFunds() << std::endl;
}
