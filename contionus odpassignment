    std::string accountNum1, accountNum2;
    double initialDeposit1, initialDeposit2, depositAmount, withdrawalAmount;
    std::cout << "Enter account number for account 1: ";
    std::cin >> accountNum1;
    std::cout << "Enter initial deposit for account 1: ";
    std::cin >> initialDeposit1;
    std::cout << "Enter account number for account 2: ";
    std::cin >> accountNum2;
    std::cout << "Enter initial deposit for account 2: ";
    std::cin >> initialDeposit2;
    BankAccount account1(accountNum1, initialDeposit1);
    BankAccount account2(accountNum2, initialDeposit2);
    std::cout << "Total bank funds: " << BankAccount::getBankFunds() << std::endl;
    std::cout << "Enter deposit amount for account 1: ";
    std::cin >> depositAmount;
    account1.deposit(depositAmount);
