#include <iostream>
#include <string>
class BankAccount {
private:
    std::string accountNumber;
    double balance;
    static double bankFunds; 
public:
    // Constructor
    BankAccount(std::string accountNumber, double initialDeposit) : accountNumber(accountNumber), balance(initialDeposit) {
        bankFunds += initialDeposit;
    }
    double deposit(double amount) {
        balance += amount;
        bankFunds += amount;
        return balance; 
    }
    double withdraw(double amount) {
        if (amount <= balance) {
            balance -= amount;
            bankFunds -= amount;
            return balance; 
        } else {
            std::cout << "Insufficient funds" << std::endl;
            return balance; 
        }
    }
    static double getBankFunds() {
        return bankFunds;
    }
    std::string getAccountNumber() const {
        return accountNumber;
    }

    double getBalance() const {
        return balance;
    }
};
double BankAccount::bankFunds = 0;
